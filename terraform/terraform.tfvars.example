# Copy to terraform.tfvars and fill in.

aws_region     = "ap-southeast-2" # Sydney
name_prefix    = "kdop-control"
instance_type  = "t3.medium"
use_spot       = true
root_volume_gb = 30

# Default: Session Manager only (no key pair, no port 22)
enable_ssm = true
enable_ssh = false
# key_name = null   # leave unset / omit

# Optional SSH instead of / in addition to SSM:
# enable_ssh       = true
# create_key_pair  = true
# key_name         = "kdop-ec2"
# ssh_public_key   = "ssh-ed25519 AAAA... your@laptop"

# Leave empty to auto-detect your public IP /32 for 6443 (and SSH if enabled)
# admin_cidr = "1.2.3.4/32"

gateway_cidrs = ["0.0.0.0/0"]
